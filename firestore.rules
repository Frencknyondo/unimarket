rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This app currently uses Firestore documents as its own login store
    // instead of Firebase Authentication, so request.auth is null for users.
    // Keep these permissive only for development/prototype use.
    function isValidUserCreate() {
      return request.resource.data.keys().hasAll([
        'uid',
        'email',
        'registrationNo',
        'fullName',
        'password',
        'role',
        'createdAt'
      ]);
    }

    match /unimarket_db/{userId} {
      allow read: if true;
      allow create: if isValidUserCreate();
      allow update, delete: if true;
    }

    match /listings/{listingId} {
      allow read, create, update, delete: if true;
    }

    match /favorites/{favoriteId} {
      allow read, create, update, delete: if true;
    }

    match /orders/{orderId} {
      allow read, create, update, delete: if true;
    }

    match /notifications/{notificationId} {
      allow read, create, update, delete: if true;
    }

    match /chats/{chatId} {
      allow read, create, update, delete: if true;

      match /messages/{messageId} {
        allow read, create, update, delete: if true;
      }
    }
  }
}
